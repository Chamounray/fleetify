NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/fleetify?directConnection=true
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=UTC
BUSINESS_NAME=Fleetify Local Fleet
BUSINESS_ADDRESS=100 Harbor Yard
CURRENCY=USD
SEED_ADMIN_EMAIL=admin@fleetify.local
SEED_ADMIN_PASSWORD=ChangeMeNow!23
SEED_ON_START=false
# Error logs (400/404/500 etc.) append under server/logs/ by default
# LOG_DIR=C:\path\to\logs
# LOG_ERRORS=true
# Production single-service (Render): serve the Vite build from the API
# SERVE_CLIENT=true
# CLIENT_DIST=
# Bootstrap admins only (no fleet seed) — set these in Render Shell, never commit:
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_SUPERADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
